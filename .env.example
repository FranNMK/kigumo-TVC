PORT=3000
NODE_ENV=production
SESSION_SECRET=

# Comma-separated list of allowed CORS origins (no trailing slashes).
# Include every domain the browser-side app is served from.
# Example: APP_ORIGINS=https://www.kigumotvc.ac.ke,https://assets.kigumotvc.ac.ke
APP_ORIGINS=

# Legacy Railway deployment — remove this line once Railway is fully retired.
# RAILWAY_PUBLIC_DOMAIN=

DB_HOST=
DB_PORT=4000
DB_USER=
DB_PASSWORD=
DB_NAME=kigumo_tvc
DB_SSL=true

# SSL certificate for TiDB Cloud (required for rejectUnauthorized: true).
# Obtain the CA certificate from your TiDB Cloud cluster's connection details page.
# Option A — path to the downloaded .pem file on the server:
# DB_SSL_CA_PATH=/home/<cpanel-user>/ssl/tidb-ca.pem
# Option B — base64-encoded certificate (useful when file paths are inconvenient):
# DB_SSL_CA_BASE64=<base64-encoded-cert>
#
# Without one of the above, the server falls back to rejectUnauthorized:false
# (encrypted but unauthenticated). Set one of these to enable full verification.

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=