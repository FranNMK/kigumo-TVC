# Example environment file for Kigumo TVC
# Copy this to `.env` and fill in real values. DO NOT commit your `.env` to Git.

# Database settings
DB_HOST=your-db-host.example.com
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=your_db_name
SESSION_SECRET=change_this_to_a_random_secret
PORT=4000
DB_SSL=true
# If using a CA file for TLS, set a relative path (optional)
DB_SSL_CA_PATH=server/certs/tidb-ca.pem

# Cloudinary (media) - leave blank if not using Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Logging and environment
LOG_LEVEL=INFO
NODE_ENV=production

# Useful tips:
# - Keep real secrets in `.env` (not this example) and add `.env` to .gitignore.
# - For large-file handling, consider using Git LFS for uploads/ directory.